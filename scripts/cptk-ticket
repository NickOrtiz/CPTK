#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: cptk-ticket <ticket-id> <short-name> [base-branch] [options]" >&2
  echo "       cptk-ticket --multi <issue-id> <short-name> <sub-ticket-id>... [options]" >&2
  echo >&2
  echo "Options:" >&2
  echo "  --base <branch>    Branch to start from (default: the current branch)" >&2
  echo "  --path <dir>       Where to create the worktree (default: ../<project>-<ticket-id>-<short-name>)." >&2
  echo "                     The directory must not exist, or must be empty." >&2
  echo "  --branch <name>    Name of the new branch (default: feature/<ticket-id>-<short-name>)" >&2
  echo >&2
  echo "Example: cptk-ticket ABC-123 hero develop" >&2
  echo "Example: cptk-ticket ABC-123 hero --base develop --branch team/hero --path ~/sites/hero/wp-content" >&2
  echo "Example: cptk-ticket --multi ISSUE-B typography TYPO-01 TYPO-02 TYPO-03 --base develop" >&2
  exit 1
}

MULTI=0
SUB_TICKETS=()
BASE_BRANCH=""
WORKTREE_PATH=""
BRANCH_NAME=""
POSITIONAL=()

if [[ "${1:-}" == "--multi" ]]; then
  MULTI=1
  shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --base|--path|--branch)
      [[ $# -lt 2 || -z "$2" ]] && usage
      case "$1" in
        --base) BASE_BRANCH="$2" ;;
        --path) WORKTREE_PATH="$2" ;;
        --branch) BRANCH_NAME="$2" ;;
      esac
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    -*)
      echo "cptk-ticket: unknown option: $1" >&2
      usage
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [[ "$MULTI" -eq 1 ]]; then
  [[ ${#POSITIONAL[@]} -lt 3 ]] && usage
  TICKET_ID="${POSITIONAL[0]}"
  SHORT_NAME="${POSITIONAL[1]}"
  SUB_TICKETS=("${POSITIONAL[@]:2}")
else
  [[ ${#POSITIONAL[@]} -lt 2 || ${#POSITIONAL[@]} -gt 3 ]] && usage
  TICKET_ID="${POSITIONAL[0]}"
  SHORT_NAME="${POSITIONAL[1]}"

  # The base branch can still be given as the third positional argument.
  if [[ ${#POSITIONAL[@]} -eq 3 ]]; then
    if [[ -n "$BASE_BRANCH" ]]; then
      echo "cptk-ticket: give the base branch once, either positionally or with --base." >&2
      exit 1
    fi
    BASE_BRANCH="${POSITIONAL[2]}"
  fi
fi

TOOLKIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
  echo "cptk-ticket: run this inside a git repository." >&2
  exit 1
fi

INVOKED_FROM="$(pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

GIT_DIR_ABS="$(cd "$(git rev-parse --git-dir)" && pwd -P)"
GIT_COMMON_ABS="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"

if [[ "$GIT_DIR_ABS" != "$GIT_COMMON_ABS" ]]; then
  echo "cptk-ticket: already inside a worktree ($REPO_ROOT)." >&2
  echo "Run cptk-ticket from the main repository checkout, not from inside another ticket's worktree." >&2
  exit 1
fi

if [[ -z "$BASE_BRANCH" ]]; then
  BASE_BRANCH="$(git branch --show-current)"
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "cptk-ticket: current worktree has uncommitted changes." >&2
  echo "Commit/stash them before scaffolding another ticket." >&2
  exit 1
fi

PROJECT_NAME="$(basename "$REPO_ROOT")"
SAFE_TICKET="$(printf '%s' "$TICKET_ID" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-')"
SAFE_NAME="$(printf '%s' "$SHORT_NAME" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-')"

BRANCH="${BRANCH_NAME:-feature/${TICKET_ID}-${SAFE_NAME}}"

if ! git check-ref-format --branch "$BRANCH" >/dev/null 2>&1; then
  echo "cptk-ticket: not a valid branch name: $BRANCH" >&2
  exit 1
fi

if [[ -n "$WORKTREE_PATH" ]]; then
  # Expand a leading ~ and resolve relative paths against where the command was run.
  WORKTREE_PATH="${WORKTREE_PATH/#\~/$HOME}"
  [[ "$WORKTREE_PATH" != /* ]] && WORKTREE_PATH="$INVOKED_FROM/$WORKTREE_PATH"
  WORKTREE="${WORKTREE_PATH%/}"
else
  WORKTREE="$(dirname "$REPO_ROOT")/${PROJECT_NAME}-${TICKET_ID}-${SAFE_NAME}"
fi

if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
  echo "cptk-ticket: branch already exists: $BRANCH" >&2
  exit 1
fi

# An empty directory is fine (for example one a local site tool created); anything else is refused.
if [[ -e "$WORKTREE" ]] && { [[ ! -d "$WORKTREE" ]] || [[ -n "$(ls -A "$WORKTREE")" ]]; }; then
  echo "cptk-ticket: target path already exists and is not an empty directory: $WORKTREE" >&2
  exit 1
fi

if [[ ! -d "$(dirname "$WORKTREE")" ]]; then
  echo "cptk-ticket: parent directory does not exist: $(dirname "$WORKTREE")" >&2
  exit 1
fi

WORKTREE="$(cd "$(dirname "$WORKTREE")" && pwd -P)/$(basename "$WORKTREE")"

echo "Base branch: $BASE_BRANCH"
echo "New branch:  $BRANCH"
echo "Worktree:    $WORKTREE"
echo

git worktree add "$WORKTREE" -b "$BRANCH" "$BASE_BRANCH"

mkdir -p "$WORKTREE/.cptk/tickets"

scaffold_ticket_file() {
  local id="$1"
  local title="$2"
  local file="$WORKTREE/.cptk/tickets/${id}.md"

  if [[ ! -e "$file" ]]; then
    sed \
      -e "s/{{TICKET_ID}}/${id}/g" \
      -e "s/{{TITLE}}/${title}/g" \
      "$TOOLKIT_ROOT/templates/ticket-context.md" > "$file"
  fi

  printf '%s\n' "$file"
}

TICKET_FILE="$(scaffold_ticket_file "$TICKET_ID" "$SHORT_NAME")"

SUB_FILES=()
if [[ "$MULTI" -eq 1 ]]; then
  for SUB_ID in "${SUB_TICKETS[@]}"; do
    SUB_FILES+=("$(scaffold_ticket_file "$SUB_ID" "$SHORT_NAME")")
  done
fi

baseline_step() {
  local label="$1"
  shift
  echo "+ $label"
  if "$@"; then
    echo "  ok: $label"
  else
    echo "  WARNING: $label failed — worktree may start from a broken baseline (possibly pre-existing, not necessarily caused by this ticket)." >&2
  fi
}

cd "$WORKTREE"

echo
echo "Baseline check"
echo "--------------"

if [[ -f pnpm-lock.yaml ]]; then
  baseline_step "pnpm install" pnpm install
  baseline_step "pnpm test" pnpm test --if-present
elif [[ -f yarn.lock ]]; then
  baseline_step "yarn install" yarn install
elif [[ -f package.json ]]; then
  baseline_step "npm install" npm install
  baseline_step "npm test" npm test --if-present
elif [[ -f Cargo.toml ]]; then
  baseline_step "cargo build" cargo build
  baseline_step "cargo test" cargo test
elif [[ -f go.mod ]]; then
  baseline_step "go mod download" go mod download
  baseline_step "go test" go test ./...
elif [[ -f pyproject.toml ]] && command -v poetry >/dev/null 2>&1; then
  baseline_step "poetry install" poetry install
elif [[ -f requirements.txt ]]; then
  baseline_step "pip install" pip install -r requirements.txt
else
  echo "(no recognized manifest — skipping automatic install/test baseline)"
fi

echo
echo "Ready:"
echo "  cd \"$WORKTREE\""

if [[ "$MULTI" -eq 1 ]]; then
  echo "  \$EDITOR \"$TICKET_FILE\"   # issue overview"
  for SUB_FILE in "${SUB_FILES[@]}"; do
    echo "  \$EDITOR \"$SUB_FILE\""
  done
  echo "  claude"
  echo
  echo "Then run inside Claude, one at a time in this same worktree/session"
  echo "(one worktree = one active session; do not run these concurrently):"
  for SUB_ID in "${SUB_TICKETS[@]}"; do
    echo "  /start-ticket $SUB_ID"
  done
else
  echo "  \$EDITOR \"$TICKET_FILE\""
  echo "  claude"
  echo
  echo "Then run inside Claude:"
  echo "  /start-ticket $TICKET_ID"
fi
